server {
    listen 80;
    listen [::]:80;
    server_name www.ecogcoretechnologies.com;
    return 301 https://ecogcoretechnologies.com$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name ecogcoretechnologies.com;
    return 301 https://ecogcoretechnologies.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.ecogcoretechnologies.com;

    # Keep the existing verified Hostinger/Let's Encrypt certificate directives.
    return 301 https://ecogcoretechnologies.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ecogcoretechnologies.com;

    # Copy the existing verified Hostinger/Let's Encrypt certificate directives here.
    client_max_body_size 10m;

    location /static/ {
        alias /var/www/ecog/current/staticfiles/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    location /media/ {
        alias /var/www/ecog/shared/media/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
    }

    location / {
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://unix:/run/ecog/gunicorn.sock;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;
}
