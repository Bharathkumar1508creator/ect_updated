# Copy to a root-owned file outside the repository and adjust every path.
APP_ROOT=/var/www/ecog
BACKUP_ROOT=/var/backups/ecog
ENV_FILE=/var/www/ecog/shared/.env
MEDIA_DIR=/var/www/ecog/shared/media
NGINX_CONFIG=/etc/nginx/sites-available/ecog
SYSTEMD_SERVICE_FILE=/etc/systemd/system/ecog.service

# This file contains the MySQL password and must be chmod 600.
MYSQL_DEFAULTS_FILE=/root/.ecog-mysql.cnf
DB_NAME=ecog
DB_USER=ecog_backup
DB_HOST=localhost
DB_PORT=3306
