# Generate a unique production value; never commit the real secret.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ecogcoretechnologies.com,www.ecogcoretechnologies.com
DJANGO_USE_SQLITE=False
# Must match the Nginx /media/ alias and be persistent across releases.
DJANGO_MEDIA_ROOT=/var/www/ecog/shared/media
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_CSRF_TRUSTED_ORIGINS=https://ecogcoretechnologies.com,https://www.ecogcoretechnologies.com

# Enable only when Nginx overwrites X-Forwarded-Proto and direct public access to
# the application port is blocked by the VPS firewall.
DJANGO_TRUST_PROXY_SSL_HEADER=True
# Enable only when Nginx replaces (rather than appends untrusted input to)
# X-Forwarded-For. This is used solely for public form rate limits.
DJANGO_TRUST_X_FORWARDED_FOR=False
DJANGO_PUBLIC_FORM_RATE_LIMIT=8
DJANGO_PUBLIC_FORM_RATE_WINDOW=900

# Required in production so rate limits are shared by every Gunicorn worker.
# Development continues to use an in-memory cache and does not need Redis.
REDIS_URL=redis://127.0.0.1:6379/1
DJANGO_CACHE_TIMEOUT=300

# Public metadata.
SITE_URL=https://ecogcoretechnologies.com
BLOG_PUBLISHER_NAME=ECOG Core Technologies
BLOG_PUBLISHER_LOGO=/static/img/ECT%20LOGO.png
BLOG_FALLBACK_IMAGE=/media/blog/website-development-guide-2026/website-development-guide-cover.webp

# Production MySQL/MariaDB connection. Use a dedicated least-privilege account.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
# Set this to the hosting provider's CA certificate path when remote MySQL TLS is required.
DB_SSL_CA=
